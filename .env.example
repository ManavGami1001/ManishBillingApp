# Database Connection (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Auth.js Secrets
AUTH_SECRET="your-super-secret-auth-key-generate-via-openssl"

# Email Verification (Google SMTP)
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-google-app-password"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
